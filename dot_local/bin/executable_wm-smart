#!/usr/bin/env bash
set -euo pipefail

name="${1:-}"
if [[ -z "$name" ]]; then
    echo "usage: wm-smart <name>" >&2
    exit 1
fi

handle=$(workmux list --json 2>/dev/null \
    | jq -r --arg n "$name" '.[] | select(.handle == $n or .branch == $n) | .handle' \
    | head -1)

if [[ -n "$handle" ]]; then
    exec workmux open "$handle"
else
    exec workmux add "$name"
fi
